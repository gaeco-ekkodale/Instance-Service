{
	"name": "instance-client",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite --mode devlocal",
		"build:production": "tsc && vite build --mode production",
		"build:test": "tsc && vite build --mode test",
		"build:development": "tsc -b && vite build --mode development",
		"build:devlocal": "tsc -b && vite build --mode devlocal",
		"build": "tsc -b && vite build",
		"lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
		"preview": "vite preview",
		"generate-instance-client-local": "openapi --input http://localhost:5024/swagger/v1/swagger.json --output src/services/instance --client fetch",
		"generate-guideline-client-local": "openapi --input http://localhost:5008/swagger/v1/swagger.json --output src/services/guideline --client fetch",
		"generate-ontology-client-local": "openapi --input http://localhost:5023/swagger/v1/swagger.json --output src/services/ontology --client fetch",
		"generate-access-client-local": "openapi --input http://localhost:5131/swagger/v1/swagger.json --output src/services/access --client fetch",
		"generate-usecase-client-local": "openapi --input http://localhost:5087/swagger/v1/swagger.json --output src/services/usecase --client fetch"
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.0",
		"@microsoft/signalr": "^8.0.7",
		"@mui/icons-material": "^6.2.1",
		"@mui/material": "^6.2.1",
		"@tailwindcss/vite": "^4.2.2",
		"@tanstack/react-query": "^5.59.15",
		"jwt-decode": "^4.0.0",
		"material-react-table": "^3.2.1",
		"notistack": "^3.0.2",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-oidc-context": "^3.3.0",
		"react-router-dom": "^6.27.0",
		"react-vis-graph-wrapper": "^0.1.3",
		"sonner": "^1.5.0"
	},
	"devDependencies": {
		"@originjs/vite-plugin-federation": "^1.4.1",
		"@tailwindcss/postcss": "^4.1.17",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@typescript-eslint/eslint-plugin": "^7.18.0",
		"@typescript-eslint/parser": "^7.18.0",
		"@vitejs/plugin-react": "^4.3.3",
		"eslint": "^8.57.1",
		"eslint-plugin-react-hooks": "^4.6.2",
		"eslint-plugin-react-refresh": "^0.4.13",
		"openapi-typescript-codegen": "^0.29.0",
		"postcss": "^8.4.47",
		"prettier": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.2",
		"vite": "^7.1.3"
	}
}
