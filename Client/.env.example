# =============================================================================
# InstanceService Client - local dev server (npm run dev)
# =============================================================================
# Copy this file to `.env` - every value below is a working
# LOCAL default. The passwords are deliberately simple and are intended
# ONLY for local use, never for a deployed environment.
#
# Keycloak: this module expects its OWN realm client
# (VITE_KEYCLOAK_CLIENT_ID=instance-client). The shipped realm export only
# contains plugin-host-client, so create it once in Keycloak - logging in
# through plugin-host-client would NOT carry your own client roles.
# See Gaeco/_docu/developer/keycloak/own-keycloak-client.md
# =============================================================================

# API urls
VITE_INSTANCE_SERVER_URL=http://localhost:5024
VITE_USECASE_SERVER_URL=http://localhost:5130
VITE_ONTOLOGY_SERVER_URL=http://localhost:5023
VITE_ACCESS_SERVER_URL=http://localhost:5131
VITE_GUIDELINE_SERVER_URL=http://localhost:5008

# Keycloak relevance
VITE_KEYCLOAK_AUTHORITY=http://localhost:9345/realms/gaeco
VITE_KEYCLOAK_CLIENT_ID=instance-client

# route prefix
VITE_MOUNT_PATH=instance
