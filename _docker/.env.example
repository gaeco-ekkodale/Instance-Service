# =============================================================================
# InstanceService - local docker environment
# =============================================================================
# Copy this file to `.env` - every value below is a working
# LOCAL default. The passwords are deliberately simple and are intended
# ONLY for local use, never for a deployed environment.
#
# IMAGE_BASE_PATH points at the Gaeco Azure Container Registry - log in with
# `az acr login --name crgaeco001` (or change it to your own registry) before the first start.
#
# Keycloak: the browser login for this micro-frontend is handled by the shell.
# Its own client id (instance-client) is only read by StandaloneApp, which is not
# exported via module federation and therefore never runs in the Docker image -
# so it is set in Client/.env (VITE_KEYCLOAK_CLIENT_ID), not here.
# See Gaeco/_docu/developer/keycloak/own-keycloak-client.md
# =============================================================================

# =============================================================================
# IMAGE TAGS
# =============================================================================
INSTANCE_SERVER_TAG=latest
INSTANCE_CLIENT_TAG=latest

# =============================================================================
# GLOBAL SETTINGS
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
IMAGE_BASE_PATH=crgaeco001.azurecr.io

# =============================================================================
# ASPIRE DASHBOARD (Monitoring)
# =============================================================================
OTLP_ENDPOINT=http://gaeco-monitor-aspire:18889

# =============================================================================
# KAFKA (Message Broker)
# =============================================================================
KAFKA_ADDRESS=gaeco-broker:29092

# --- Broker-level settings (shared by all consumers)
KAFKA_AUTO_OFFSET_RESET=Earliest
KAFKA_SESSION_TIMEOUT_MS=150000
KAFKA_MAX_POLL_INTERVAL_MS=1500000
KAFKA_MESSAGE_MAX_BYTES=52428800

# --- Consumer "GraphDataModel" (pattern-based gaecoImport consumer)
KAFKA_CONSUMER_GROUP_GRAPHDATAMODEL=instance-service-group
KAFKA_TOPIC_PATTERN=^.*\..*\..*\.public\..*\.gaecoImport$

# --- Consumer "Guidelines"
KAFKA_CONSUMER_GROUP_GUIDELINES=instance-service-guideline-group
KAFKA_TOPICS_GUIDELINES=ekkodale.gaeco.guideline.public.uploaded

# --- Consumer "Ontology"
KAFKA_CONSUMER_GROUP_ONTOLOGY=instance-service-ontology-group
KAFKA_TOPICS_ONTOLOGY=ekkodale.gaeco.ontology.public.uploaded

# =============================================================================
# MINIO (Object Storage)
# =============================================================================
MINIO_ADDRESS=gaeco-minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# =============================================================================
# KEYCLOAK (Authentication)
# =============================================================================
KEYCLOAK_SERVER_HOSTNAME=localhost:9345
KEYCLOAK_REALM=gaeco

# --- Backend: confidential client (service account, has a secret)
KEYCLOAK_CLIENT_ID=app-instance
KEYCLOAK_CLIENT_SECRET=F2GcfERBDP7kCMTLQHxGVddCaH9QeODs

# =============================================================================
# EXTERNAL SERVICE HOSTNAMES
# =============================================================================
USECASE_SERVER_HOSTNAME=localhost:5130
ONTOLOGY_SERVER_HOSTNAME=localhost:5023
ACCESS_SERVER_HOSTNAME=localhost:5131
GUIDELINE_SERVER_HOSTNAME=localhost:5008

# =============================================================================
# INSTANCE SERVICE
# =============================================================================
# --- Instance Service ArcadeDB (Gremlin)
INSTANCE_ARCADEDB_USER=InstanceService
INSTANCE_ARCADEDB_PASSWORD=arcadedb-local-pw
INSTANCE_ARCADEDB_DATABASE=InstanceServiceGremlin
INSTANCE_ARCADEDB_HTTP_OUTERPORT=2480
INSTANCE_ARCADEDB_BINARY_OUTERPORT=2424
INSTANCE_ARCADEDB_GREMLIN_OUTERPORT=8182

# --- Instance Service Postgres
INSTANCE_POSTGRES_DATABASE=InstanceServiceDB
INSTANCE_POSTGRES_USER=InstanceService
INSTANCE_POSTGRES_PASSWORD=instance-local-pw

# --- Instance Service Server
INSTANCE_SERVER_HOSTNAME=localhost:5024

# --- Instance Service Client
MOUNT_ROUTE=/instance

# =============================================================================
# LOCAL DEVELOPMENT ONLY
# Die folgenden Variablen werden in deployed Umgebungen vom Orchestrator
# injiziert und sind ausschliesslich fuer den lokalen Docker-Compose-Betrieb
# benoetigt.
# =============================================================================
STACK_NAME=instance
ENVIRONMENT_NETWORK=gaeco-local
TRAEFIK_NETWORK=traefik-proxy
VOLUME_BASE_PATH=./volumes

# --- Override (Port-Bindings)
INSTANCE_POSTGRES_OUTERPORT=5814
INSTANCE_SERVER_OUTERPORT=5024
INSTANCE_CLIENT_OUTERPORT=5026
